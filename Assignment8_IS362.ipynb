      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "## getting and loading data from uci repo link\n",
        "url = \"https://archive.ics.uci.edu/ml/machine-learning-databases/auto-mpg/auto-mpg.data\"\n",
        "cols = ['mpg', 'cylinder', 'displacement', 'horsepower', 'weight',\n",
        "        'acceleration', 'model_year', 'origin', 'car_name']\n",
        "df = pd.read_csv(url, delim_whitespace=True, names=cols)\n",
        "\n",
        "## fixing horesepower data and making it a number\n",
        "df['horsepower'] = df['horsepower'].replace('?', np.nan)\n",
        "df['horsepower'] = pd.to_numeric(df['horsepower'])\n",
        "\n",
        "## changing origin numbers to places\n",
        "df['origin'] = df['origin'].map({1: 'USA', 2: 'Asia', 3: 'Europe'})"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "## making basic bar chart for showing cylinder distribution\n",
        "df['cylinder'].value_counts().plot(kind='bar')\n",
        "plt.title('Cylinder Distribution')\n",
        "plt.xlabel('Cylinder')\n",
        "plt.ylabel('Count')\n",
        "plt.show()\n"
      ],
