      "source": [
        "## making basic scatterplot for horsepower vs weight\n",
        "plt.scatter(df['weight'], df['horsepower'])\n",
        "plt.title('Horsepower vs Weight')\n",
        "plt.xlabel('Weight')\n",
        "plt.ylabel('Horsepower')\n",
