      "source": [
        "## questions : displaying mgp distribution\n",
        "print(\"Question : How does fuel efficiency/mpg compare across different regions?\")\n",
        "\n",
        "## answer\n",
        "sns.boxplot(data=df,  x='origin', y='mpg')\n",
        "plt.title('MPG by region')\n",
